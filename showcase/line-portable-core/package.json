{
  "name": "line-portable-core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "smoke": "tsx tests/smoke.ts",
    "start": "node --env-file-if-exists=.env --import tsx apps/gateway/src/server.ts",
    "build:miniapp": "vite build --config apps/miniapp/vite.config.ts",
    "check": "npm run typecheck && npm run test && npm run smoke"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@line/liff": "2.31.0",
    "hono": "^4.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
